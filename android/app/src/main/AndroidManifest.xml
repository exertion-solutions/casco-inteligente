<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Video: camara (runtime; se concede con pm grant, ver README-VIDEO.md) y wake lock durante la transmision. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Voz: RECORD_AUDIO es de runtime (targetSdk 28): se concede con pm grant (tools/instalar-agente.ps1). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Posicion en SOS/caida y evento location (docs/PROTOCOLO-GEO.md). Runtime con targetSdk 28: pm grant. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:label="Casco Agente"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <!-- Detecta el boton SOS (KEY_F11) sin consumirlo: RundeCap sigue recibiendolo. -->
        <service
            android:name=".SosKeyService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Sin UI: abrirla desbloquea el paquete (stopped/DuraSpeed) y arranca el servicio. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Observa fotos/videos nuevos y los sube. -->
        <service android:name=".MediaWatcherService" android:exported="false" />

        <!-- Transmite la camara trasera por RTMP (comando remoto o SOS/caida). -->
        <service
            android:name=".StreamService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- BOOT_COMPLETED es un broadcast del sistema: llega aunque no este exportado. -->
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Alarma cada ~5 min: relanza MediaWatcherService si el sistema lo mato. -->
        <receiver android:name=".WatchdogReceiver" android:exported="false" />
    </application>
</manifest>
